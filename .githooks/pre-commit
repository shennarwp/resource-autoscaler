#!/bin/sh
if [ -d /mnt/wsl ]; then
  # Already inside WSL (terminal testing / WSL git): run lefthook directly.
  cd "$(git rev-parse --show-toplevel)/frontend" || exit 1
  ./node_modules/.bin/lefthook run pre-commit
else
  # Invoked from Windows git (Sublime Merge): bridge into WSL.
  REPO=$(git rev-parse --show-toplevel)
  wsl.exe -e bash -c "cd \"\$(wslpath -u '$REPO')/frontend\" && export PATH=\"\$HOME\"/.nvm/versions/node/v26.7.0/bin:\"\$HOME\"/tools/jdk/bin:\$PATH && ./node_modules/.bin/lefthook run pre-commit"
fi