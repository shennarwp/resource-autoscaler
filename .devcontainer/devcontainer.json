{
  "name": "resource-autoscaler",
  // Java 25 comes from the base image. Maven is added via the java feature
  // with version "none" (keeps the base image's Java, only installs Maven
  // 3.9.10 to match maven-wrapper.properties). There is no standalone maven
  // feature. Node, Docker (host socket), kubectl/helm, Azure CLI and GitHub
  // CLI are added as features so the Debian host itself stays clean
  // (no global Java/Node/Maven/Go).
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": true,
      "mavenVersion": "3.9.10"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "Spring Boot backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "openPreview"
    }
  },
  // Inside the container the backend is on container-localhost, not on the
  // Docker bridge gateway, so pin the Vite proxy target instead of letting
  // vite.config.ts guess it from `ip route`.
  "containerEnv": {
    "VITE_BACKEND_TARGET": "http://localhost:8080",
    // Pin the base image's JDK: the java feature above exports an SDKMAN
    // JAVA_HOME that would otherwise shadow it (its java install is "none").
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current"
  },
  "postCreateCommand": "cd frontend && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vitest.explorer",
        "oxc.oxc-vscode"
      ]
    }
  },
  "shutdownAction": "none"
}
