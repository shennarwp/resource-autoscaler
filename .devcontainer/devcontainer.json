{
  "name": "resource-autoscaler",
  // Java 25 comes from the base image; Maven 3.9.10 (matching
  // maven-wrapper.properties) is baked in via the Dockerfile, because there
  // is no standalone maven feature and the java feature would shadow
  // JAVA_HOME with a dangling SDKMAN path. Node, Docker (host socket),
  // kubectl/helm, Azure CLI and GitHub CLI are added as features so the
  // Debian host itself stays clean (no global Java/Node/Maven/Go).
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "Spring Boot backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "openPreview"
    }
  },
  // Inside the container the backend is on container-localhost, not on the
  // Docker bridge gateway, so pin the Vite proxy target instead of letting
  // vite.config.ts guess it from `ip route`.
  "containerEnv": {
    "VITE_BACKEND_TARGET": "http://localhost:8080"
  },
  // Host ~/.ssh (keys, config, known_hosts) is visible inside the container
  // read-only so git-over-SSH and the IDE's git integration work there.
  // Nothing is copied: same files, container-local reads. Requires the host
  // uid to match the container user (both 1000 on a default Debian install).
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly"
  ],
  "postCreateCommand": "cd frontend && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vitest.explorer",
        "oxc.oxc-vscode"
      ]
    }
  },
  "shutdownAction": "none"
}
